{
	"name": "pi-extensions",
	"version": "0.0.0",
	"private": true,
	"description": "Monorepo for @narumitw pi extension packages.",
	"type": "module",
	"workspaces": [
		"packages/pi-btw",
		"packages/pi-goal",
		"packages/pi-plan-mode",
		"packages/pi-sync",
		"packages/pi-tui-kit"
	],
	"pi": {
		"extensions": [
			"./packages/pi-btw/src/index.ts",
			"./packages/pi-goal/src/bootstrap.ts",
			"./packages/pi-plan-mode/src/bootstrap.ts",
			"./packages/pi-sync/src/bootstrap.ts"
		]
	},
	"scripts": {
		"format": "biome format --write .",
		"lint": "biome lint .",
		"biome:check": "biome check .",
		"check:boundaries": "node ./scripts/check-extension-boundaries.mjs",
		"typecheck": "node ./scripts/run-typechecks.mjs",
		"build": "npm --workspaces --if-present run build",
		"test": "node ./scripts/run-tests.mjs",
		"check": "npm run build && node ./scripts/run-checks.mjs",
		"precommit": "npm run biome:check && npm run typecheck",
		"prepare": "node .husky/install.mjs",
		"changeset": "changeset",
		"changeset:status": "changeset status --verbose",
		"version-packages": "changeset version && npm install --package-lock-only --ignore-scripts",
		"publish-packages": "changeset publish",
		"pack:btw": "npm --workspace @narumitw/pi-btw pack --dry-run",
		"pack:goal": "npm --workspace @narumitw/pi-goal pack --dry-run",
		"pack:plan-mode": "npm --workspace @narumitw/pi-plan-mode pack --dry-run",
		"pack:sync": "npm --workspace @narumitw/pi-sync pack --dry-run"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.8",
		"@changesets/cli": "3.0.0",
		"@earendil-works/pi-agent-core": "0.84.2",
		"@earendil-works/pi-ai": "0.84.2",
		"@earendil-works/pi-coding-agent": "0.84.2",
		"@earendil-works/pi-tui": "0.84.2",
		"@types/node": "^26.2.0",
		"concurrently": "^10.0.5",
		"husky": "9.1.7",
		"npm-check-updates": "23.0.2",
		"typebox": "^1.3.14",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	},
	"overrides": {
		"brace-expansion": "5.0.9",
		"node-domexception": "npm:@profoundlogic/node-domexception@1.0.2",
		"protobufjs": "7.6.5"
	},
	"allowScripts": {
		"esbuild@0.28.1": true,
		"@google/genai": false,
		"protobufjs": false
	}
}
